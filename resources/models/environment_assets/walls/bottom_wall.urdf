<?xml version='1.0' encoding='UTF-8'?>
<robot name="bottom_wall">

  <!-- 1. FLAT START (X = -10 to 0) -->
  <link name="flat_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="flat_visual">
      <geometry><box size="10 20 0.2"/></geometry>
      <origin xyz="-5 0 0" rpy="0 0 0"/>
    </visual>
    <collision name="flat_collision">
      <geometry><box size="10 20 0.2"/></geometry>
      <origin xyz="-5 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- 2. TILTED RAMP (X = 0 to 10) -->
  <!-- TILT ANGLE = 35 deg = 0.610865 rad (negative pitch = rising toward +X) -->
  <link name="ramp_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="ramp_visual">
      <geometry><box size="12.208 20 0.2"/></geometry>
      <origin xyz="5 0 3.501" rpy="0 -0.610865 0"/>
    </visual>
    <collision name="ramp_collision">
      <geometry><box size="12.208 20 0.2"/></geometry>
      <origin xyz="5 0 3.501" rpy="0 -0.610865 0"/>
    </collision>
  </link>

  <!-- 3. FLAT TOP (X = 10 to 20) -->
  <!-- Height = 10 * tan(angle) = 7.002 -->
  <link name="top_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="top_visual">
      <geometry><box size="10 20 0.2"/></geometry>
      <origin xyz="15 0 7.002" rpy="0 0 0"/>
    </visual>
    <collision name="top_collision">
      <geometry><box size="10 20 0.2"/></geometry>
      <origin xyz="15 0 7.002" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- 4. TILTED RAMP DOWN (X = 20 to 30) -->
  <!-- TILT ANGLE = 35 deg = 0.610865 rad (positive pitch = descending toward +X) -->
  <link name="ramp_down_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="ramp_down_visual">
      <geometry><box size="12.208 20 0.2"/></geometry>
      <origin xyz="25 0 3.501" rpy="0 0.610865 0"/>
    </visual>
    <collision name="ramp_down_collision">
      <geometry><box size="12.208 20 0.2"/></geometry>
      <origin xyz="25 0 3.501" rpy="0 0.610865 0"/>
    </collision>
  </link>

  <!-- 5. FLAT END (X = 30 to 40) -->
  <link name="end_flat_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="end_flat_visual">
      <geometry><box size="10 20 0.2"/></geometry>
      <origin xyz="35 0 0" rpy="0 0 0"/>
    </visual>
    <collision name="end_flat_collision">
      <geometry><box size="10 20 0.2"/></geometry>
      <origin xyz="35 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- 6. LEFT WALL (Y = +10, X = -10 to 40, Z = 0 to 15) -->
  <link name="left_wall_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="left_wall_visual">
      <geometry><box size="50 0.2 15"/></geometry>
      <origin xyz="15 10 7.5" rpy="0 0 0"/>
    </visual>
    <collision name="left_wall_collision">
      <geometry><box size="50 0.2 15"/></geometry>
      <origin xyz="15 10 7.5" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- 7. RIGHT WALL (Y = -10, X = -10 to 40, Z = 0 to 15) -->
  <link name="right_wall_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="right_wall_visual">
      <geometry><box size="50 0.2 15"/></geometry>
      <origin xyz="15 -10 7.5" rpy="0 0 0"/>
    </visual>
    <collision name="right_wall_collision">
      <geometry><box size="50 0.2 15"/></geometry>
      <origin xyz="15 -10 7.5" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- 8. BACK WALL (X = -10, Y = -10 to 10, Z = 0 to 15) -->
  <link name="back_wall_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="back_wall_visual">
      <geometry><box size="0.2 20 15"/></geometry>
      <origin xyz="-10 0 7.5" rpy="0 0 0"/>
    </visual>
    <collision name="back_wall_collision">
      <geometry><box size="0.2 20 15"/></geometry>
      <origin xyz="-10 0 7.5" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- 9. FRONT WALL (X = 40, Y = -10 to 10, Z = 0 to 15) -->
  <link name="front_wall_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="front_wall_visual">
      <geometry><box size="0.2 20 15"/></geometry>
      <origin xyz="40 0 7.5" rpy="0 0 0"/>
    </visual>
    <collision name="front_wall_collision">
      <geometry><box size="0.2 20 15"/></geometry>
      <origin xyz="40 0 7.5" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="base_to_ramp" type="fixed">
    <parent link="flat_link"/>
    <child link="ramp_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="ramp_to_top" type="fixed">
    <parent link="ramp_link"/>
    <child link="top_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="top_to_ramp_down" type="fixed">
    <parent link="top_link"/>
    <child link="ramp_down_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="ramp_down_to_end" type="fixed">
    <parent link="ramp_down_link"/>
    <child link="end_flat_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_left_wall" type="fixed">
    <parent link="flat_link"/>
    <child link="left_wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_right_wall" type="fixed">
    <parent link="flat_link"/>
    <child link="right_wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_back_wall" type="fixed">
    <parent link="flat_link"/>
    <child link="back_wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_front_wall" type="fixed">
    <parent link="flat_link"/>
    <child link="front_wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>